<Window x:Class="SmartFileClassifier.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:SmartFileClassifier.ViewModels"
        xmlns:converters="clr-namespace:SmartFileClassifier.Converters"
        xmlns:models="clr-namespace:SmartFileClassifier.Models"
        Title="Smart File Classifier"
        Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <viewmodels:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:IntGreaterThanZeroToVisibilityConverter x:Key="IntToVis" />
        <converters:NamingStyleToDisplayConverter x:Key="StyleToDisplay" />
        <converters:CategoryCounterConverter x:Key="CategoryCounter" />
    </Window.Resources>

     <Border Background="{DynamicResource BackgroundColor}"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#40000000" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>

            <!-- ===== Title Bar ===== -->
            <Border Grid.Row="0" Background="{DynamicResource ToolbarBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <TextBlock Text="&#xE7C5;" FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource AccentColor}"
                                   FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Smart File Classifier"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   FontSize="16" FontWeight="SemiBold"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ToggleButton x:Name="ThemeToggle"
                                      IsChecked="{Binding IsDarkTheme}"
                                      Width="48" Height="26"
                                      ClickMode="Press"
                                      ToolTip="{Binding IsDarkTheme, Converter={StaticResource BoolToThemeText}, StringFormat='Switch to {0} mode'}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="ThemeOuter"
                                            Background="#E9ECEF"
                                            CornerRadius="13">
                                        <Grid>
                                            <Border x:Name="ThemeTrack"
                                                    Background="#E9ECEF"
                                                    CornerRadius="13"
                                                    Width="48" Height="26">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#15000000" BlurRadius="2" ShadowDepth="0"/>
                                                </Border.Effect>
                                            </Border>
                                            <Border x:Name="ThemeThumb"
                                                    Background="#FFFFFF"
                                                    CornerRadius="12"
                                                    Width="22" Height="22"
                                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="Center"
                                                    Margin="2,0,0,0">
                                                <TextBlock x:Name="ThemeIcon"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Text="&#xE7A0;"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThemeOuter" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="ThemeTrack" Property="Background" Value="#007ACC"/>
                                            <Setter TargetName="ThemeThumb" Property="HorizontalAlignment" Value="Right"/>
                                            <Setter TargetName="ThemeThumb" Property="Margin" Value="0,0,2,0"/>
                                            <Setter TargetName="ThemeIcon" Property="Text" Value="&#xE7A2;"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Button x:Name="CloseButton"
                                Width="32" Height="32"
                                Click="Close_Click"
                                ToolTip="Close"
                                Style="{StaticResource ModernOutlinedButtonStyle}"
                                Margin="8,0,0,0">
                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Folder Picker ===== -->
            <Border Grid.Row="1" Background="{DynamicResource PanelBackground}"
                    CornerRadius="8" Margin="16,16,16,0"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <Border.Effect>
                    <DropShadowEffect Color="#10000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#xE148;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{DynamicResource AccentColor}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedFolderPath, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBoxStyle}"
                             ToolTip="Folder path"/>

                    <Button Grid.Column="2"
                            Command="{Binding BrowseCommand}"
                            Style="{StaticResource ModernButtonStyle}"
                            Height="36"
                            Margin="0,0,8,0"
                            ToolTip="Browse for folder">
                        <Button.Content>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7C5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Browse"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button.Content>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Main Content ===== -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="3.5*"/>
                    <ColumnDefinition Width="2"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Summary Panel -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackground}"
                        CornerRadius="8" Margin="16,0,8,16"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        
                    <Border.Effect>
                        <DropShadowEffect Color="#10000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Summary"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,0,0,16"/>

                            <!-- Total Files Card -->
                            <Border Style="{StaticResource SummaryCardStyle}" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Classifications.Count}"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentColor}"/>
                                    <TextBlock Text="Total Files"
                                               Style="{StaticResource CaptionStyle}"
                                               Foreground="{DynamicResource SecondaryForeground}"/>
                                </StackPanel>
                            </Border>

                            <!-- Category Cards -->
                            <UniformGrid Columns="2" Margin="0,0,0,8">
                                <Border Style="{StaticResource SummaryCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Classifications,
                                                      ConverterParameter=Audio,
                                                      Converter={StaticResource CategoryCounter}}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#4FC3F7"/>
                                        <TextBlock Text="Audio"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{DynamicResource SecondaryForeground}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Classifications,
                                                      ConverterParameter=Video,
                                                      Converter={StaticResource CategoryCounter}}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#FFB74D"/>
                                        <TextBlock Text="Video"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{DynamicResource SecondaryForeground}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Classifications,
                                                      ConverterParameter=Image,
                                                      Converter={StaticResource CategoryCounter}}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#81C784"/>
                                        <TextBlock Text="Images"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{DynamicResource SecondaryForeground}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource SummaryCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Classifications,
                                                      ConverterParameter=Folder,
                                                      Converter={StaticResource CategoryCounter}}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#BA68C8"/>
                                        <TextBlock Text="Other"
                                                   Style="{StaticResource CaptionStyle}"
                                                   Foreground="{DynamicResource SecondaryForeground}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Separator Margin="0,0,0,12" Background="{DynamicResource BorderColor}"/>

                            <TextBlock Text="{Binding StatusMessage}"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Margin="0,0,0,4"/>

                            <ProgressBar IsIndeterminate="{Binding IsScanning}"
                                         Height="3"
                                         Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"
                                         Foreground="{DynamicResource AccentColor}"
                                         Background="{DynamicResource SecondaryPanelBackground}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Center: DataGrid -->
                <Border Grid.Column="1" Background="{DynamicResource PanelBackground}"
                        CornerRadius="8" Margin="8,0,8,16"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        
                    <Border.Effect>
                        <DropShadowEffect Color="#10000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <DataGrid x:Name="PreviewGrid"
                                  ItemsSource="{Binding Classifications}"
                                  Style="{StaticResource ModernDataGridStyle}"
                                  Margin="0">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select"
                                                        Binding="{Binding IsSelected, Mode=TwoWay}"
                                                        Width="40"/>
                                <DataGridTextColumn Header="Original Name"
                                                    Binding="{Binding OriginalName}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Category"
                                                    Binding="{Binding Category}"
                                                    Width="100"/>
                                <DataGridTextColumn Header="Purpose"
                                                    Binding="{Binding Purpose}"
                                                    Width="130"/>
                                <DataGridTextColumn Header="New Name"
                                                    Binding="{Binding NewName}"
                                                    Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Background="{DynamicResource DataGridHeaderBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="0,1,0,0"
                                Height="28"
                                VerticalAlignment="Bottom"
                                Visibility="{Binding Classifications.Count, Converter={StaticResource IntToVis}}">
                            <DockPanel>
                                <TextBlock Text="{Binding Classifications.Count, StringFormat='{}Showing {0} items'}"
                                           DockPanel.Dock="Left"
                                           VerticalAlignment="Center"
                                           Margin="10,0"
                                           Foreground="{DynamicResource SecondaryForeground}"
                                           FontSize="11"/>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right: Settings Panel -->
                <Border Grid.Column="2" Background="{DynamicResource PanelBackground}"
                        CornerRadius="8" Margin="8,0,16,16"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        
                    <Border.Effect>
                        <DropShadowEffect Color="#10000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Settings"
                                       Style="{StaticResource SectionHeaderStyle}"
                                       Margin="0,0,0,16"/>

                            <!-- Naming Style -->
                            <TextBlock Text="Naming Style"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding NamingStyles}"
                                      SelectedItem="{Binding SelectedNamingStyle}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Margin="0,0,0,12">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource StyleToDisplay}}"
                                                   FontSize="13"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Sort Order -->
                            <TextBlock Text="Sort Order"
                                       Style="{StaticResource BodyTextStyle}"
                                       Foreground="{DynamicResource SecondaryForeground}"
                                       Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding SortOrders}"
                                      SelectedItem="{Binding SelectedSortOrder}"
                                      Style="{StaticResource ModernComboBoxStyle}"
                                      Margin="0,0,0,16">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource SortOrderToDisplay}}"
                                                   FontSize="13"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- Scan Options Section -->
                            <Border Background="{DynamicResource SecondaryPanelBackground}"
                                    CornerRadius="6" Padding="12"
                                    Margin="0,0,0,12"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Scan Options"
                                               Style="{StaticResource CaptionStyle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryForeground}"
                                               Margin="0,0,0,6"/>
                                    <CheckBox Content="Recursive scan (subfolders)"
                                              IsChecked="{Binding IsRecursiveScan}"
                                              Style="{StaticResource ModernCheckBoxStyle}"/>
                                    <CheckBox Content="Include hidden files"
                                              IsChecked="{Binding IncludeHiddenFiles}"
                                              Style="{StaticResource ModernCheckBoxStyle}"/>
                                    <CheckBox Content="Include system files"
                                              IsChecked="{Binding IncludeSystemFiles}"
                                              Style="{StaticResource ModernCheckBoxStyle}"/>
                                    <CheckBox Content="Case sensitive naming"
                                              IsChecked="{Binding CaseSensitiveNaming}"
                                              Style="{StaticResource ModernCheckBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Rename Options Section -->
                            <Border Background="{DynamicResource SecondaryPanelBackground}"
                                    CornerRadius="6" Padding="12"
                                    Margin="0,0,0,16"
                                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Rename Options"
                                               Style="{StaticResource CaptionStyle}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryForeground}"
                                               Margin="0,0,0,6"/>
                                    <CheckBox Content="Preserve original extension"
                                              IsChecked="{Binding PreserveExtension, Mode=TwoWay}"
                                              IsEnabled="False"
                                              Style="{StaticResource ModernCheckBoxStyle}"/>
                                    <CheckBox Content="Preview only (dry run)"
                                              IsChecked="{Binding PreviewOnly}"
                                              Style="{StaticResource ModernCheckBoxStyle}"/>
                                    <CheckBox Content="Auto-close after rename"
                                              IsChecked="{Binding AutoCloseAfterRename}"
                                              Style="{StaticResource ModernCheckBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons -->
                            <Button
                                    Command="{Binding RescanCommand}"
                                    Style="{StaticResource ModernOutlinedButtonStyle}"
                                    Height="36"
                                    Margin="0,0,0,8"
                                    ToolTip="Re-scan the selected folder">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE7BB;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="Rescan"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button x:Name="RenameButton"
                                    Command="{Binding RenameAllCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Height="36"
                                    Margin="0,0,0,8"
                                    IsEnabled="{Binding CanRename}"
                                    ToolTip="Rename all selected files">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE748;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="Rename All"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>

                            <Button
                                    Command="{Binding ClearLogCommand}"
                                    Style="{StaticResource ModernOutlinedButtonStyle}"
                                    Height="32"
                                    ToolTip="Clear log output">
                                <Button.Content>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="Clear Log"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </Button.Content>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ===== Log Area ===== -->
            <Border Grid.Row="3" Background="{DynamicResource LogBackground}"
                    CornerRadius="8" Margin="16,0,16,16"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#10000000" BlurRadius="6" ShadowDepth="1" Opacity="0.3"/>
                </Border.Effect>
                <TextBox Text="{Binding LogOutput}"
                         FontFamily="Consolas"
                         FontSize="11"
                         Foreground="{DynamicResource LogForeground}"
                         Background="{DynamicResource LogBackground}"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         Padding="12"/>
            </Border>
        </Grid>
    </Border>
</Window>
