<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors -->
    <SolidColorBrush x:Key="BackgroundColor" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#E9ECEF"/>
    <SolidColorBrush x:Key="SecondaryPanelBackground" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="ForegroundColor" Color="#212529"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#6C757D"/>
    <SolidColorBrush x:Key="TertiaryForeground" Color="#9CA3AF"/>
    <SolidColorBrush x:Key="BorderColor" Color="#DEE2E6"/>
    <SolidColorBrush x:Key="DarkBorderColor" Color="#CED4DA"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
    <SolidColorBrush x:Key="AccentHoverColor" Color="#106EBE"/>
    <SolidColorBrush x:Key="AccentPressedColor" Color="#005A9E"/>
    <SolidColorBrush x:Key="AccentBackgroundColor" Color="#E6F0FF"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessColor" Color="#28A745"/>
    <SolidColorBrush x:Key="SuccessBackgroundColor" Color="#E6F4EA"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFC107"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#DC3545"/>
    <SolidColorBrush x:Key="InfoColor" Color="#17A2B8"/>

    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#E9ECEF"/>
    <SolidColorBrush x:Key="DataGridHeaderForeground" Color="#495057"/>
    <SolidColorBrush x:Key="DataGridAlternatingRowBackground" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="DataGridSelectedRowBackground" Color="#E6F0FF"/>
    <SolidColorBrush x:Key="DataGridSelectedRowForeground" Color="#000000"/>

    <!-- Log Area (always dark for contrast) -->
    <SolidColorBrush x:Key="LogBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="LogForeground" Color="#D4D4D4"/>

    <!-- Toggle Switch Colors -->
    <SolidColorBrush x:Key="ToggleThumbLight" Color="#6C757D"/>
    <SolidColorBrush x:Key="ToggleTrackOffLight" Color="#DEE2E6"/>
    <SolidColorBrush x:Key="ToggleTrackOnLight" Color="#007ACC"/>
    <SolidColorBrush x:Key="ToggleThumbDark" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ToggleThumbOn" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleTrackOffDark" Color="#3C3C40"/>
    <SolidColorBrush x:Key="ToggleTrackOn" Color="#007ACC"/>

    <!-- Icon Brush -->
    <SolidColorBrush x:Key="IconBrush" Color="#6C757D"/>
    <SolidColorBrush x:Key="IconBrushAccent" Color="#007ACC"/>

</ResourceDictionary>
