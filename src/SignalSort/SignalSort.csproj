<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>SignalSort</RootNamespace>
    <AssemblyName>SignalSort</AssemblyName>
    <AssemblyTitle>SignalSort</AssemblyTitle>
    <AssemblyDescription>Identify. Understand. Rename.</AssemblyDescription>
    <Product>SignalSort</Product>
    <Company>Ean</Company>
    <Copyright>Copyright (c) Ean</Copyright>
    <Authors>Ean</Authors>
    <Version>0.3.0</Version>
    <ApplicationIcon>Resources/SignalSort.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release publish: self-contained, NOT single-file.
       TagLibSharp (LGPL-2.1) must ship as a separate, replaceable DLL so
       recipients can modify the library and relink (LGPL section 6).
       Do not re-enable PublishSingleFile without revisiting
       THIRD-PARTY-NOTICES.md. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <!-- Ship license/attribution documents with every distribution
       (Apache-2.0 NOTICE requirement + LGPL-2.1 license-text requirement). -->
  <ItemGroup>
    <None Include="Resources\licenses\TagLibSharp-LGPL-2.1.txt" CopyToOutputDirectory="PreserveNewest"
          Link="licenses\TagLibSharp-LGPL-2.1.txt" />
    <None Include="..\..\LICENSE" CopyToOutputDirectory="PreserveNewest" Link="licenses\LICENSE" />
    <None Include="..\..\NOTICE" CopyToOutputDirectory="PreserveNewest" Link="licenses\NOTICE" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest"
          Link="licenses\THIRD-PARTY-NOTICES.md" />
    <None Include="..\..\docs\public\licensing\third-party\TagLibSharp-source-verification.txt"
          CopyToOutputDirectory="PreserveNewest" Link="licenses\TagLibSharp-source-verification.txt" />
  </ItemGroup>

</Project>
