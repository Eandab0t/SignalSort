<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>SignalSort</RootNamespace>
    <AssemblyName>SignalSort</AssemblyName>
    <AssemblyTitle>SignalSort</AssemblyTitle>
    <AssemblyDescription>Identify. Understand. Rename.</AssemblyDescription>
    <Product>SignalSort</Product>
    <Company>Ean</Company>
    <Copyright>Copyright (c) Ean</Copyright>
    <Authors>Ean</Authors>
    <Version>0.3.0</Version>
    <ApplicationIcon>Resources/SignalSort.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Release publish: self-contained, NOT single-file.
       TagLibSharp (LGPL-2.1) must ship as a separate, replaceable DLL so
       recipients can modify the library and relink (LGPL section 6).
       Do not re-enable PublishSingleFile without revisiting
       THIRD-PARTY-NOTICES.md. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

</Project>
