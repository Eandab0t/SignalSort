<Window x:Class="SignalSort.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SignalSort.Models"
        Title="SignalSort"
        Height="800" Width="1360" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

    <Window.DataContext>
        <viewmodels:MainViewModel xmlns:viewmodels="clr-namespace:SignalSort.ViewModels"/>
    </Window.DataContext>

    <Window.Resources>
        <!-- Category badge color mapping -->
        <DataTemplate x:Key="CategoryBadge">
            <Border CornerRadius="3" Padding="7,3" Margin="0,0,8,0"
                    Background="{DynamicResource BadgeDocumentBackground}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource BadgeDocumentBackground}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Category}" Value="Audio">
                                <Setter Property="Background" Value="{DynamicResource BadgeAudioBackground}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Video">
                                <Setter Property="Background" Value="{DynamicResource BadgeVideoBackground}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Image">
                                <Setter Property="Background" Value="{DynamicResource BadgeImageBackground}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Folder">
                                <Setter Property="Background" Value="{DynamicResource BadgeFolderBackground}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Category}" Value="Archive">
                                <Setter Property="Background" Value="{DynamicResource BadgeFolderBackground}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="11" FontWeight="SemiBold" FontFamily="Segoe UI">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource BadgeDocumentForeground}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="Audio">
                                    <Setter Property="Foreground" Value="{DynamicResource BadgeAudioForeground}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="Video">
                                    <Setter Property="Foreground" Value="{DynamicResource BadgeVideoForeground}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="Image">
                                    <Setter Property="Foreground" Value="{DynamicResource BadgeImageForeground}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="Folder">
                                    <Setter Property="Foreground" Value="{DynamicResource BadgeFolderForeground}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="Archive">
                                    <Setter Property="Foreground" Value="{DynamicResource BadgeFolderForeground}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                    <Run Text="{Binding Category, Mode=OneWay}"/>
                </TextBlock>
            </Border>
        </DataTemplate>

        <!-- File row -->
        <DataTemplate x:Key="FileRow" DataType="{x:Type models:FileClassification}">
            <Border x:Name="rowBd" Padding="12,8" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderColor}" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}"
                              IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                              Margin="0,0,12,0"/>

                    <ContentPresenter Grid.Column="1" ContentTemplate="{StaticResource CategoryBadge}"
                                      Content="{Binding}" VerticalAlignment="Center"/>

                    <!-- Original name + signals -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0">
                        <TextBlock Text="{Binding OriginalName}" FontFamily="Segoe UI" FontSize="13"
                                   Foreground="{DynamicResource ForegroundColor}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                        <TextBlock FontFamily="Segoe UI" FontSize="11" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TertiaryForeground}"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding SignalSummary, Mode=OneWay}"/>
                    </StackPanel>

                    <!-- Arrow -->
                    <TextBlock Grid.Column="3" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource TertiaryForeground}"/>

                    <!-- New name -->
                    <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding NewName}" FontFamily="Segoe UI" FontSize="13"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding NewName}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentMutedText}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tag}" Value="conflict">
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock FontFamily="Segoe UI" FontSize="11" Text="{Binding Purpose}"
                                       Foreground="{DynamicResource SecondaryForeground}"/>
                            <TextBlock FontFamily="Segoe UI" FontSize="11" Margin="8,0,0,0"
                                       Text="{Binding ConfidenceLabel, Mode=OneWay}"
                                       Foreground="{DynamicResource TertiaryForeground}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Conflict marker -->
                    <TextBlock Grid.Column="5" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               VerticalAlignment="Center" ToolTip="Name collision - will be skipped">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tag}" Value="conflict">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="rowBd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="rowBd" Property="Background" Value="{DynamicResource RowHoverBackground}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelectedForInspect}" Value="True">
                    <Setter TargetName="rowBd" Property="Background" Value="{DynamicResource RowSelectedBackground}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource BackgroundColor}"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ================= Header ================= -->
            <Grid Grid.Row="0" Background="{DynamicResource ToolbarBackground}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo mark: three gray bars + purple rail (EanCord geometry) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,10,0" VerticalAlignment="Center">
                    <Grid Width="22" Height="22">
                        <Rectangle Fill="{DynamicResource LogoGrayColor}" Height="4" VerticalAlignment="Top"    Margin="0,2,5,0"/>
                        <Rectangle Fill="{DynamicResource LogoGrayColor}" Height="4" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <Rectangle Fill="{DynamicResource LogoGrayColor}" Height="4" VerticalAlignment="Bottom" Margin="0,0,5,2"/>
                        <Rectangle Fill="{DynamicResource AccentColor}" Width="5" HorizontalAlignment="Right"/>
                    </Grid>
                    <TextBlock Text="SignalSort" FontFamily="Segoe UI" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource ForegroundColor}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Folder path -->
                <Border Grid.Column="1" Background="{DynamicResource ElevatedBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="4" Padding="10,5" Margin="8,0" MaxWidth="460">
                    <TextBlock Text="{Binding SelectedFolderPath}" FontFamily="Consolas" FontSize="11.5"
                               Foreground="{DynamicResource SecondaryForeground}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFolderPath}"/>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Select Folder" Style="{StaticResource SecondaryButton}"
                            Command="{Binding BrowseCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Scan" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelScanButton" Style="{StaticResource GhostButton}"
                            Content="Cancel" Command="{Binding CancelScanCommand}" Margin="0,0,4,0"/>
                </StackPanel>

                <!-- Chrome buttons -->
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding ToggleThemeCommand}"
                            Width="38" FontFamily="Segoe MDL2 Assets" FontSize="13" Padding="0"
                            Content="{Binding IsDarkTheme, Converter={StaticResource BoolToThemeIcon}}"
                            ToolTip="Toggle theme"/>
                    <Button Style="{StaticResource GhostButton}" Width="38" Padding="0" Click="Minimize_Click"
                            Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                            ToolTip="Minimize"/>
                    <Button Style="{StaticResource GhostButton}" Width="38" Padding="0" Click="Maximize_Click"
                            x:Name="MaximizeButton" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                            ToolTip="Maximize"/>
                    <Button Style="{StaticResource GhostButton}" Width="38" Padding="0" Click="Close_Click"
                            Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                            ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- Progress -->
            <ProgressBar Grid.Row="1" Style="{StaticResource SlimProgress}" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            <!-- ================= Body ================= -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Navigation rail ===== -->
                <Border Grid.Column="0" Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,12,0,4">
                            <TextBlock Text="LIBRARY" Style="{StaticResource SectionLabel}" Margin="16,0,0,6"/>
                            <RadioButton Content="All Files" Style="{StaticResource NavButton}" GroupName="nav" Tag="All Files" IsChecked="True" Click="Nav_Click"/>
                            <RadioButton Content="Images" Style="{StaticResource NavButton}" GroupName="nav" Tag="Images" Click="Nav_Click"/>
                            <RadioButton Content="Audio" Style="{StaticResource NavButton}" GroupName="nav" Tag="Audio" Click="Nav_Click"/>
                            <RadioButton Content="Video" Style="{StaticResource NavButton}" GroupName="nav" Tag="Video" Click="Nav_Click"/>
                            <RadioButton Content="Documents" Style="{StaticResource NavButton}" GroupName="nav" Tag="Documents" Click="Nav_Click"/>
                            <RadioButton Content="Folders" Style="{StaticResource NavButton}" GroupName="nav" Tag="Folders" Click="Nav_Click"/>
                            <RadioButton Content="Conflicts" Style="{StaticResource NavButton}" GroupName="nav" Tag="Conflicts" Click="Nav_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="0,0,0,12">
                            <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabel}" Margin="16,0,0,6"/>
                            <RadioButton Content="History" Style="{StaticResource NavButton}" GroupName="nav" Tag="History" Click="Nav_Click"/>
                            <RadioButton Content="Settings" Style="{StaticResource NavButton}" GroupName="nav" Tag="Settings" Click="Nav_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== Center workspace ===== -->
                <Grid Grid.Column="1" Background="{DynamicResource BackgroundColor}"
                      AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">

                    <!-- Empty state: logo-bar motif -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Cursor="Hand" MouseLeftButtonUp="EmptyState_Click"
                                Visibility="{Binding HasFiles, Converter={StaticResource InverseBoolToVis}}">
                        <Grid Width="140" Height="110" HorizontalAlignment="Center" Opacity="0.9">
                            <Rectangle Fill="{DynamicResource LogoGrayColor}" Height="16" RadiusX="2" RadiusY="2"
                                       VerticalAlignment="Top" Margin="0,6,26,0"/>
                            <Rectangle Fill="{DynamicResource LogoGrayColor}" Height="16" RadiusX="2" RadiusY="2"
                                       VerticalAlignment="Center" Margin="0,0,26,0"/>
                            <Rectangle Fill="{DynamicResource LogoGrayColor}" Height="16" RadiusX="2" RadiusY="2"
                                       VerticalAlignment="Bottom" Margin="0,0,26,6"/>
                            <Rectangle Fill="{DynamicResource AccentColor}" Width="14" RadiusX="2" RadiusY="2"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="Select or drop a folder to begin" FontFamily="Segoe UI" FontSize="16"
                                   Foreground="{DynamicResource ForegroundColor}" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        <TextBlock Text="SignalSort identifies what your files are - not just what their extensions say."
                                   FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForeground}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- File list -->
                    <Grid Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Toolbar -->
                        <Border Grid.Row="0" Padding="14,10" BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                             VerticalContentAlignment="Center"/>
                                    <ComboBox Grid.Column="1" Width="170" Margin="10,0,0,0"
                                              ItemsSource="{Binding NamingStyles}"
                                              SelectedItem="{Binding SelectedNamingStyle}"/>
                                    <ComboBox Grid.Column="2" Width="150" Margin="10,0,0,0"
                                              ItemsSource="{Binding SortOrders}"
                                              SelectedItem="{Binding SelectedSortOrder}"/>
                                </Grid>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                                    <Button Content="Select all" Style="{StaticResource GhostButton}"
                                            Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                                    <Button Content="None" Style="{StaticResource GhostButton}"
                                            Command="{Binding SelectNoneCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListView Grid.Row="1" ItemsSource="{Binding ItemsView}"
                                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                  ItemTemplate="{StaticResource FileRow}"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  SelectionMode="Single">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="10,0,10,0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>

                    <!-- History panel -->
                    <StackPanel Visibility="{Binding IsHistoryPanel, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Rename History" Style="{StaticResource BaseText}" FontSize="16"
                                   FontWeight="SemiBold" Margin="20,18,0,8"/>
                        <TextBlock Text="The last 10 rename batches. Undo reverses the most recent completed batch."
                                   Style="{StaticResource BaseText}" FontSize="12" Margin="20,0,20,14"
                                   Foreground="{DynamicResource SecondaryForeground}" TextWrapping="Wrap"/>
                        <Border Margin="20,0,20,0" Background="{DynamicResource PanelBackground}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="4">
                            <TextBlock Text="{Binding HistoryText}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource SecondaryForeground}" Padding="14,12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <!-- Settings panel -->
                    <StackPanel Visibility="{Binding IsSettingsPanel, Converter={StaticResource BoolToVis}}"
                                Margin="20,18,20,0">
                        <TextBlock Text="Settings" Style="{StaticResource BaseText}" FontSize="16"
                                   FontWeight="SemiBold" Margin="0,0,0,14"/>
                        <CheckBox IsChecked="{Binding IsRecursiveScan}" Content="Scan subfolders recursively"
                                  Foreground="{DynamicResource ForegroundColor}" FontFamily="Segoe UI" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox IsChecked="{Binding IncludeHiddenFiles}" Content="Include hidden files"
                                  Foreground="{DynamicResource ForegroundColor}" FontFamily="Segoe UI" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox IsChecked="{Binding IncludeSystemFiles}" Content="Include system files"
                                  Foreground="{DynamicResource ForegroundColor}" FontFamily="Segoe UI" FontSize="13" Margin="0,0,0,10"/>
                        <CheckBox IsChecked="{Binding PreserveExtension}" Content="Preserve file extensions"
                                  Foreground="{DynamicResource ForegroundColor}" FontFamily="Segoe UI" FontSize="13"/>
                        <TextBlock Text="Settings are stored in %LOCALAPPDATA%\SignalSort."
                                   Style="{StaticResource BaseText}" FontSize="11" Margin="0,22,0,0"
                                   Foreground="{DynamicResource TertiaryForeground}"/>
                    </StackPanel>
                </Grid>

                <!-- ===== Inspector ===== -->
                <Border Grid.Column="2" Background="{DynamicResource InspectorBackground}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1,0,0,0">
                    <Grid Margin="16,14,16,14">
                        <TextBlock Text="Select a file to inspect its classification." FontSize="12"
                                   Foreground="{DynamicResource TertiaryForeground}" TextWrapping="Wrap"
                                   VerticalAlignment="Top" Margin="0,6,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource BaseText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="INSPECTOR"/>
                                <TextBlock Text="{Binding SelectedItem.OriginalName}" Style="{StaticResource BaseText}"
                                           FontSize="15" FontWeight="SemiBold" Margin="0,8,0,2" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedItem.FullPath}" FontFamily="Consolas" FontSize="10.5"
                                           Foreground="{DynamicResource TertiaryForeground}" TextWrapping="Wrap"/>

                                <!-- Detected purpose -->
                                <TextBlock Style="{StaticResource SectionLabel}" Text="DETECTED PURPOSE" Margin="0,18,0,6"/>
                                <ComboBox x:Name="PurposeBox" IsEditable="True"
                                          ItemsSource="{Binding KnownPurposes}"
                                          Text="{Binding SelectedItem.Purpose, Mode=OneWay}"/>
                                <Button Content="Apply correction" Style="{StaticResource SecondaryButton}"
                                        Margin="0,8,0,0" HorizontalAlignment="Left" Click="ApplyPurpose_Click"/>
                                <TextBlock Text="{Binding SelectedItem.ConfidenceLabel, Mode=OneWay}"
                                           Style="{StaticResource BaseText}" FontSize="11" Margin="0,8,0,0"
                                           Foreground="{DynamicResource TertiaryForeground}"/>

                                <!-- Evidence -->
                                <TextBlock Style="{StaticResource SectionLabel}" Text="EVIDENCE" Margin="0,18,0,6"/>
                                <ItemsControl ItemsSource="{Binding SelectedItem.Signals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontFamily="Segoe UI" FontSize="12"
                                                           Foreground="{DynamicResource SecondaryForeground}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Segoe UI" FontSize="12"
                                                           Foreground="{DynamicResource ForegroundColor}" TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Proposed name -->
                                <TextBlock Style="{StaticResource SectionLabel}" Text="PROPOSED NAME" Margin="0,18,0,6"/>
                                <TextBox Text="{Binding SelectedItem.NewName, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="Edits here override the generated name for this file."
                                           Style="{StaticResource BaseText}" FontSize="11" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TertiaryForeground}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- ================= Bottom dock ================= -->
            <Border Grid.Row="3" Background="{DynamicResource DockBackground}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SuccessColor}"/>
                                    <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="CollisionCount" Converter="{StaticResource GreaterThanZero}"/>
                                        </DataTrigger.Binding>
                                        <Setter Property="Fill" Value="{DynamicResource ErrorColor}"/>
                                    </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Style="{StaticResource BaseText}" FontSize="12"
                                   Foreground="{DynamicResource SecondaryForeground}">
                            <Run Text="{Binding SelectedCount, Mode=OneWay}"/>
                            <Run Text="selected �"/>
                            <Run Text="{Binding ChangesCount, Mode=OneWay}"/>
                            <Run Text="changes �"/>
                            <Run Text="{Binding CollisionCount, Mode=OneWay}"/>
                            <Run Text="collisions"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Preview" Style="{StaticResource SecondaryButton}"
                                Command="{Binding PreviewCommand}" Margin="0,0,8,0" ToolTip="Write the planned renames to the log"/>
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding UndoCommand}"
                                Margin="0,0,8,0" ToolTip="Undo the last rename batch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Undo" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RenameCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Rename" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
