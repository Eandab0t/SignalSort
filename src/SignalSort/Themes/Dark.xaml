<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Signal Rail - Dark (default)
         Sampled from the EanCord logo: gray bars #7A7C85, purple rail #8B00B4. -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundColor" Color="#09090B"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#111114"/>
    <SolidColorBrush x:Key="ElevatedBackground" Color="#18181D"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#111114"/>
    <SolidColorBrush x:Key="SecondaryPanelBackground" Color="#18181D"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundColor" Color="#F1F1F4"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#898992"/>
    <SolidColorBrush x:Key="TertiaryForeground" Color="#5B5B63"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderColor" Color="#29292F"/>
    <SolidColorBrush x:Key="StrongBorderColor" Color="#3A3A42"/>
    <SolidColorBrush x:Key="DarkBorderColor" Color="#3A3A42"/>

    <!-- Brand -->
    <SolidColorBrush x:Key="LogoGrayColor" Color="#7A7C85"/>
    <SolidColorBrush x:Key="AccentColor" Color="#8B00B4"/>
    <SolidColorBrush x:Key="AccentHoverColor" Color="#A312D4"/>
    <SolidColorBrush x:Key="AccentPressedColor" Color="#6E0090"/>
    <SolidColorBrush x:Key="AccentSubtleColor" Color="#2A1035"/>
    <SolidColorBrush x:Key="AccentMutedText" Color="#C77BE0"/>

    <!-- Status (muted) -->
    <SolidColorBrush x:Key="SuccessColor" Color="#4CAF7D"/>
    <SolidColorBrush x:Key="SuccessBackgroundColor" Color="#12241B"/>
    <SolidColorBrush x:Key="WarningColor" Color="#D9A441"/>
    <SolidColorBrush x:Key="WarningBackgroundColor" Color="#2A2113"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#D46A6A"/>
    <SolidColorBrush x:Key="ErrorBackgroundColor" Color="#2A1414"/>
    <SolidColorBrush x:Key="InfoColor" Color="#6AA9C9"/>

    <!-- Rows / list -->
    <SolidColorBrush x:Key="RowHoverBackground" Color="#1B1B21"/>
    <SolidColorBrush x:Key="RowSelectedBackground" Color="#2A1035"/>
    <SolidColorBrush x:Key="RowSelectedBorder" Color="#8B00B4"/>

    <!-- Inspector -->
    <SolidColorBrush x:Key="InspectorBackground" Color="#111114"/>

    <!-- Dock -->
    <SolidColorBrush x:Key="DockBackground" Color="#0E0E11"/>

    <!-- Log -->
    <SolidColorBrush x:Key="LogBackground" Color="#0C0C0E"/>
    <SolidColorBrush x:Key="LogForeground" Color="#A8A8B0"/>

    <!-- Category badge colors (distinguish without color alone - badges also carry text) -->
    <SolidColorBrush x:Key="BadgeAudioBackground" Color="#1E2A38"/>
    <SolidColorBrush x:Key="BadgeAudioForeground" Color="#8FC1E8"/>
    <SolidColorBrush x:Key="BadgeVideoBackground" Color="#33203D"/>
    <SolidColorBrush x:Key="BadgeVideoForeground" Color="#D0A0E8"/>
    <SolidColorBrush x:Key="BadgeImageBackground" Color="#1E3328"/>
    <SolidColorBrush x:Key="BadgeImageForeground" Color="#8FD0AC"/>
    <SolidColorBrush x:Key="BadgeDocumentBackground" Color="#2B2B31"/>
    <SolidColorBrush x:Key="BadgeDocumentForeground" Color="#B9B9C0"/>
    <SolidColorBrush x:Key="BadgeFolderBackground" Color="#33291A"/>
    <SolidColorBrush x:Key="BadgeFolderForeground" Color="#E0C28A"/>
    <SolidColorBrush x:Key="BadgeConflictBackground" Color="#2A1414"/>
    <SolidColorBrush x:Key="BadgeConflictForeground" Color="#E88A8A"/>

    <!-- Window chrome -->
    <SolidColorBrush x:Key="CaptionButtonHover" Color="#222228"/>
    <SolidColorBrush x:Key="CaptionCloseHover" Color="#C42B1C"/>

</ResourceDictionary>
