<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Signal Rail - Light -->

    <!-- Surfaces -->
    <SolidColorBrush x:Key="BackgroundColor" Color="#F4F4F6"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ElevatedBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryPanelBackground" Color="#FAFAFB"/>

    <!-- Text -->
    <SolidColorBrush x:Key="ForegroundColor" Color="#1A1A1F"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#5F5F68"/>
    <SolidColorBrush x:Key="TertiaryForeground" Color="#6B6B74"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderColor" Color="#E1E1E6"/>
    <SolidColorBrush x:Key="StrongBorderColor" Color="#C9C9D1"/>
    <SolidColorBrush x:Key="DarkBorderColor" Color="#C9C9D1"/>

    <!-- Brand -->
    <SolidColorBrush x:Key="LogoGrayColor" Color="#7A7C85"/>
    <SolidColorBrush x:Key="AccentColor" Color="#7A00A0"/>
    <SolidColorBrush x:Key="AccentHoverColor" Color="#8B00B4"/>
    <SolidColorBrush x:Key="AccentPressedColor" Color="#5E0080"/>
    <SolidColorBrush x:Key="AccentSubtleColor" Color="#F3E8F8"/>
    <SolidColorBrush x:Key="AccentMutedText" Color="#6E0090"/>

    <!-- Status (muted) -->
    <SolidColorBrush x:Key="SuccessColor" Color="#2E7D51"/>
    <SolidColorBrush x:Key="SuccessBackgroundColor" Color="#E6F2EB"/>
    <SolidColorBrush x:Key="WarningColor" Color="#9A6A12"/>
    <SolidColorBrush x:Key="WarningBackgroundColor" Color="#F8EFDC"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#B23B3B"/>
    <SolidColorBrush x:Key="ErrorBackgroundColor" Color="#F9E7E7"/>
    <SolidColorBrush x:Key="InfoColor" Color="#2E6E8E"/>

    <!-- Rows / list -->
    <SolidColorBrush x:Key="RowHoverBackground" Color="#F2F0F5"/>
    <SolidColorBrush x:Key="RowSelectedBackground" Color="#F3E8F8"/>
    <SolidColorBrush x:Key="RowSelectedBorder" Color="#7A00A0"/>

    <!-- Inspector -->
    <SolidColorBrush x:Key="InspectorBackground" Color="#FAFAFB"/>

    <!-- Dock -->
    <SolidColorBrush x:Key="DockBackground" Color="#EDEDF0"/>

    <!-- Log -->
    <SolidColorBrush x:Key="LogBackground" Color="#141418"/>
    <SolidColorBrush x:Key="LogForeground" Color="#C9C9D1"/>

    <!-- Category badge colors -->
    <SolidColorBrush x:Key="BadgeAudioBackground" Color="#E4EEF7"/>
    <SolidColorBrush x:Key="BadgeAudioForeground" Color="#2E5E86"/>
    <SolidColorBrush x:Key="BadgeVideoBackground" Color="#F0E4F7"/>
    <SolidColorBrush x:Key="BadgeVideoForeground" Color="#7A2E9E"/>
    <SolidColorBrush x:Key="BadgeImageBackground" Color="#E5F2EA"/>
    <SolidColorBrush x:Key="BadgeImageForeground" Color="#2E7D51"/>
    <SolidColorBrush x:Key="BadgeDocumentBackground" Color="#ECECF0"/>
    <SolidColorBrush x:Key="BadgeDocumentForeground" Color="#54545E"/>
    <SolidColorBrush x:Key="BadgeFolderBackground" Color="#F5EDDC"/>
    <SolidColorBrush x:Key="BadgeFolderForeground" Color="#8A6A24"/>
    <SolidColorBrush x:Key="BadgeConflictBackground" Color="#F9E7E7"/>
    <SolidColorBrush x:Key="BadgeConflictForeground" Color="#A33030"/>

    <!-- Window chrome -->
    <SolidColorBrush x:Key="CaptionButtonHover" Color="#E4E4E9"/>
    <SolidColorBrush x:Key="CaptionCloseHover" Color="#C42B1C"/>

</ResourceDictionary>
