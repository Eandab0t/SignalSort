<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <SolidColorBrush x:Key="BackgroundColor" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#252526"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="SecondaryPanelBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="ForegroundColor" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="TertiaryForeground" Color="#808080"/>
    <SolidColorBrush x:Key="BorderColor" Color="#3C3C40"/>
    <SolidColorBrush x:Key="DarkBorderColor" Color="#5A5A5E"/>

    <!-- Accent Colors -->
    <SolidColorBrush x:Key="AccentColor" Color="#007ACC"/>
    <SolidColorBrush x:Key="AccentHoverColor" Color="#106EBE"/>
    <SolidColorBrush x:Key="AccentPressedColor" Color="#005A9E"/>
    <SolidColorBrush x:Key="AccentBackgroundColor" Color="#1A3A5C"/>

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessColor" Color="#4CAF50"/>
    <SolidColorBrush x:Key="SuccessBackgroundColor" Color="#1B3A2A"/>
    <SolidColorBrush x:Key="WarningColor" Color="#FFC107"/>
    <SolidColorBrush x:Key="ErrorColor" Color="#F44336"/>
    <SolidColorBrush x:Key="InfoColor" Color="#00BCD4"/>

    <!-- DataGrid Colors -->
    <SolidColorBrush x:Key="DataGridHeaderBackground" Color="#2D2D30"/>
    <SolidColorBrush x:Key="DataGridHeaderForeground" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="DataGridAlternatingRowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="DataGridSelectedRowBackground" Color="#1A3A5C"/>
    <SolidColorBrush x:Key="DataGridSelectedRowForeground" Color="#FFFFFF"/>

    <!-- Log Area -->
    <SolidColorBrush x:Key="LogBackground" Color="#121212"/>
    <SolidColorBrush x:Key="LogForeground" Color="#D4D4D4"/>

    <!-- Toggle Switch Colors -->
    <SolidColorBrush x:Key="ToggleThumbLight" Color="#6C757D"/>
    <SolidColorBrush x:Key="ToggleTrackOffLight" Color="#DEE2E6"/>
    <SolidColorBrush x:Key="ToggleTrackOnLight" Color="#007ACC"/>
    <SolidColorBrush x:Key="ToggleThumbDark" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="ToggleThumbOn" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ToggleTrackOffDark" Color="#3C3C40"/>
    <SolidColorBrush x:Key="ToggleTrackOn" Color="#007ACC"/>

    <!-- Icon Brush -->
    <SolidColorBrush x:Key="IconBrush" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="IconBrushAccent" Color="#007ACC"/>

</ResourceDictionary>
